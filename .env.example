# --- Alpaca (PAPER) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true

# --- LLM / news (optional; empty -> NEUTRAL sentiment + demo news) ---
GROQ_API_KEY=
TAVILY_API_KEY=
# News recency window (days) and result cap for the Tavily news search.
TAVILY_NEWS_DAYS=7
TAVILY_MAX_RESULTS=10

# --- CORS allowed origins (comma-separated). Blank -> "*". ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3200

# --- Execution edge (deterministic gate) ---
# Arm-to-execute: false -> an ALLOW returns DRY_RUN (nothing sent to the broker).
# Flip to true (or use POST /control/arm) to submit real paper orders on ALLOW.
EXECUTE_ENABLED=false
# Kill switch: true -> the gate blocks every order.
KILL_SWITCH=false
# Risk caps (fraction of equity): per-symbol and total exposure.
MAX_SYMBOL_EXPOSURE_PCT=0.10
MAX_TOTAL_EXPOSURE_PCT=0.30

# --- ReAct (deep research / decision reasoning) — proposal side, opt-in ---
# Default false: the cheap single-shot path runs; ?deep=true enables the loops
# (needs GROQ_API_KEY / TAVILY_API_KEY, else it fails closed to NEUTRAL/HOLD).
DEEP_RESEARCH_DEFAULT=false
RESEARCH_MAX_TURNS=3
DECISION_MAX_TURNS=3
REACT_TOOL_TIMEOUT_S=8
